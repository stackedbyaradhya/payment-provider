# Server
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Database
DATABASE_URL=postgresql://payments:payments@localhost:5433/payments?schema=public

# Auth
JWT_ACCESS_SECRET=replace-me-with-a-long-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=replace-me-with-a-different-long-random-string
JWT_REFRESH_TTL=7d

# Card vault (AES-256-GCM). 32 bytes, base64-encoded.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CARD_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
CARD_ENCRYPTION_KEY_VERSION=1

# Mock bank
MOCK_BANK_DETERMINISTIC=false
MOCK_BANK_MIN_LATENCY_MS=100
MOCK_BANK_MAX_LATENCY_MS=3000

# Rate limiting (per user, sliding window)
RATE_LIMIT_GENERAL_TTL_SECONDS=60
RATE_LIMIT_GENERAL_LIMIT=60
RATE_LIMIT_PAYMENTS_TTL_SECONDS=60
RATE_LIMIT_PAYMENTS_LIMIT=10

# Idempotency
IDEMPOTENCY_TTL_HOURS=24

# CORS
CORS_ORIGINS=http://localhost:3000
