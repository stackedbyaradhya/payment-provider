meta {
  name: Missing Idempotency-Key (422)
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/payments
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "cardToken": "{{cardToken}}",
    "amountMinor": 100,
    "currency": "USD"
  }
}

tests {
  test("422 with Idempotency-Key message", function () {
    expect(res.getStatus()).to.equal(422);
    expect(res.getBody().message).to.match(/Idempotency-Key/i);
  });
}
