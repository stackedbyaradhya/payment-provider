meta {
  name: Replay - same key, different body (409)
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/payments
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

headers {
  Content-Type: application/json
  Idempotency-Key: {{idemKey}}
}

body:json {
  {
    "cardToken": "{{cardToken}}",
    "amountMinor": 9999,
    "currency": "USD",
    "description": "oops different"
  }
}

tests {
  test("409 conflict with stable error code", function () {
    expect(res.getStatus()).to.equal(409);
    expect(res.getBody().code).to.equal("CONFLICT");
  });
}
